<INFO name="QUERY" value="SELECT gaia.source_id, gaia.ra, gaia.dec, gaia.phot_g_mean_mag, gaia.parallax, gaia.pmra, gaia.pmdec, gaia.bp_rp, tmass.designation, tmass.ra AS tmass_ra, tmass.dec AS tmass_dec, tmass.j_m, tmass.h_m, tmass.ks_m, xmatch.angular_distance
FROM gaiadr3.gaia_source AS gaia
JOIN gaiadr3.tmass_psc_xsc_best_neighbour AS xmatch USING (source_id)
JOIN gaiadr3.tmass_psc_xsc_join AS xjoin USING (clean_tmass_psc_xsc_oid)
JOIN gaiadr1.tmass_original_valid AS tmass ON xjoin.original_psc_source_id = tmass.designation
WHERE 1 = CONTAINS(POINT(&#039;ICRS&#039;, gaia.ra, gaia.dec), CIRCLE(&#039;ICRS&#039;, 132.825, 11.8, 1.0))
AND gaia.phot_g_mean_mag &lt; 14
AND tmass.ph_qual = &#039;AAA&#039;
AND parallax &gt; 0" ucd="meta.query"/>

